<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mathishree G — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#121815;
    --surface:#1a2320;
    --surface-2:#212c28;
    --text:#EDEFEA;
    --text-dim:#9BAAA4;
    --accent:#D9C36A;
    --accent-2:#6FA98C;
    --rule: rgba(237,239,234,0.12);
    box-sizing:border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  *{box-sizing:inherit;}
  html{scroll-padding-top: env(safe-area-inset-top, 0px); scroll-behavior:smooth;}
  html,body{height:100%;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Inter', -apple-system, sans-serif;
    line-height:1.6;
  }
  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]){
      --bg:#F6F4EE;
      --surface:#FFFFFF;
      --surface-2:#EFEBE0;
      --text:#1B211D;
      --text-dim:#5B6660;
      --accent:#A6822F;
      --accent-2:#3F7A5C;
      --rule: rgba(27,33,29,0.12);
    }
  }
  :root[data-theme="light"]{
    --bg:#F6F4EE;
    --surface:#FFFFFF;
    --surface-2:#EFEBE0;
    --text:#1B211D;
    --text-dim:#5B6660;
    --accent:#A6822F;
    --accent-2:#3F7A5C;
    --rule: rgba(27,33,29,0.12);
  }

  h1,h2,h3{ font-family:'Fraunces', serif; font-weight:600; margin:0; letter-spacing:-0.01em; }
  a{ color:inherit; }
  .wrap{ max-width:920px; margin:0 auto; padding:0 28px; }

  /* ---- Top bar ---- */
  header.topbar{
    position:sticky; top:0;
    top: env(safe-area-inset-top, 0px);
    z-index:10;
    background:color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom:1px solid var(--rule);
  }
  .topbar-inner{
    max-width:920px; margin:0 auto; padding:16px 28px;
    display:flex; justify-content:space-between; align-items:center;
    gap:16px;
  }
  .topbar-inner .name{ font-family:'Fraunces', serif; font-size:1.05rem; font-weight:600; }
  nav.links{ display:flex; gap:22px; font-size:0.92rem; }
  nav.links a{ text-decoration:none; color:var(--text-dim); transition:color .2s; }
  nav.links a:hover{ color:var(--accent); }
  @media (max-width:560px){
    nav.links{ display:none; }
  }

  /* ---- Hero ---- */
  .hero{ padding:88px 0 64px; display:flex; gap:48px; align-items:center; }
  .hero-text{ flex:1; min-width:0; }
  .hero-avatar{
    flex-shrink:0; width:168px; height:168px; border-radius:50%;
    overflow:hidden; border:1px solid var(--rule);
    box-shadow: 0 0 0 6px var(--surface-2);
  }
  .hero-avatar img{ width:100%; height:100%; object-fit:cover; display:block; }
  @media (max-width:640px){
    .hero{ flex-direction:column-reverse; text-align:center; gap:28px; padding-top:56px; }
    .hero-avatar{ width:132px; height:132px; }
    .hero .sub{ margin-left:auto; margin-right:auto; }
    .hero .cta-row{ justify-content:center; }
  }
  .hero .eyebrow{ color:var(--accent-2); font-size:0.95rem; margin-bottom:18px; }
  .hero h1{ font-size:clamp(2.4rem, 6vw, 3.6rem); line-height:1.08; max-width:14ch; }
  .hero .sub{ color:var(--text-dim); font-size:1.08rem; max-width:52ch; margin-top:22px; }
  .hero .cta-row{ margin-top:34px; display:flex; gap:14px; flex-wrap:wrap; }
  .btn{
    display:inline-block; padding:11px 20px; border-radius:3px;
    font-size:0.92rem; text-decoration:none; border:1px solid var(--rule);
    transition: border-color .2s, background .2s;
  }
  .btn.primary{ background:var(--accent); color:#1B211D; border-color:var(--accent); font-weight:500; }
  .btn.primary:hover{ opacity:0.9; }
  .btn.ghost:hover{ border-color:var(--accent-2); color:var(--accent-2); }

  section{ padding:56px 0; border-top:1px solid var(--rule); }
  section > .label{
    color:var(--accent-2); font-size:0.85rem; margin-bottom:26px;
    font-family:'Fraunces', serif; font-style:italic;
  }
  section h2{ font-size:1.6rem; margin-bottom:28px; }

  /* ---- Skills ---- */
  .skill-groups{ display:grid; grid-template-columns:repeat(2,1fr); gap:28px 40px; }
  @media (max-width:640px){ .skill-groups{ grid-template-columns:1fr; } }
  .skill-group h3{ font-size:0.95rem; font-family:'Inter'; font-weight:600; color:var(--text); margin-bottom:10px; }
  .chip-row{ display:flex; flex-wrap:wrap; gap:8px; }
  .chip{
    font-size:0.85rem; padding:5px 12px; border-radius:100px;
    border:1px solid var(--rule); color:var(--text-dim);
  }

  /* ---- Experience ---- */
  .exp-item{ display:grid; grid-template-columns:150px 1fr; gap:24px; }
  @media (max-width:600px){ .exp-item{ grid-template-columns:1fr; gap:8px; } }
  .exp-item .when{ color:var(--text-dim); font-size:0.88rem; }
  .exp-item h3{ font-size:1.1rem; margin-bottom:6px; }
  .exp-item .org{ color:var(--accent-2); font-size:0.95rem; margin-bottom:10px; display:block; }
  .exp-item ul{ margin:0; padding-left:18px; color:var(--text-dim); font-size:0.96rem; }
  .exp-item li{ margin-bottom:6px; }

  /* ---- Projects ---- */
  .project{
    padding:26px 0; border-top:1px solid var(--rule);
  }
  .project:first-child{ border-top:none; padding-top:0; }
  .project-head{ display:flex; justify-content:space-between; align-items:baseline; gap:16px; flex-wrap:wrap; }
  .project h3{ font-size:1.2rem; }
  .project .tag{ font-size:0.82rem; color:var(--text-dim); border:1px solid var(--rule); padding:3px 10px; border-radius:100px; white-space:nowrap; }
  .project p{ color:var(--text-dim); margin-top:10px; font-size:0.97rem; max-width:68ch; }

  /* ---- Certificates / achievements ---- */
  .list-plain{ list-style:none; padding:0; margin:0; }
  .list-plain li{
    display:flex; justify-content:space-between; gap:16px;
    padding:14px 0; border-top:1px solid var(--rule); font-size:0.96rem;
  }
  .list-plain li:first-child{ border-top:none; }
  .list-plain .when{ color:var(--text-dim); font-size:0.86rem; white-space:nowrap; }

  .achieve-list{ padding-left:0; list-style:none; }
  .achieve-list li{
    position:relative; padding:0 0 16px 22px; color:var(--text-dim); font-size:0.96rem;
  }
  .achieve-list li::before{
    content:"—"; position:absolute; left:0; color:var(--accent);
  }

  /* ---- Footer / contact ---- */
  footer{ padding:56px 0 72px; border-top:1px solid var(--rule); }
  footer h2{ font-size:1.5rem; margin-bottom:14px; }
  footer p{ color:var(--text-dim); max-width:50ch; }
  .contact-links{ margin-top:26px; display:flex; flex-direction:column; gap:10px; font-size:0.98rem; }
  .contact-links a{ text-decoration:none; }
  .contact-links a:hover{ color:var(--accent); }
  .contact-links .k{ color:var(--text-dim); display:inline-block; width:90px; }

  ::selection{ background:var(--accent); color:#1B211D; }
  a:focus-visible, button:focus-visible{ outline:2px solid var(--accent-2); outline-offset:2px; }
  @media (prefers-reduced-motion: reduce){ html{ scroll-behavior:auto; } }
</style>
</head>
